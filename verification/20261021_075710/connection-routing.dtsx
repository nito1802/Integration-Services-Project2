        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\SetTableStatus"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:DTSID="{957F319E-705B-4169-BA1B-3C64E1784B76}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
