<Window x:Class="ArchiveRelationsGenerator.Wpf.ResultWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="INSERT do Archive.ArchiveJobRelations" Width="1080" Height="700" MinWidth="760" MinHeight="480" FontFamily="Segoe UI" Background="#F3F6FA" Foreground="#19283A" WindowStartupLocation="CenterOwner">
 <Window.Resources>
<Style TargetType="Button" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Padding" Value="18,10" /><Setter Property="Background" Value="#E5ECF4" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="14" /></Style>
<Style TargetType="TextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Padding" Value="12" /><Setter Property="FontSize" Value="14" /><Setter Property="BorderBrush" Value="#CCD7E5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /></Style>
</Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Gotowy INSERT" FontSize="27" FontWeight="SemiBold"/>
  <TextBlock x:Name="ResultInfo" Grid.Row="1" Foreground="#586B80" Margin="0,8,0,18" TextWrapping="Wrap"/>
  <TextBox x:Name="SqlText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13"
   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="Zaznacz wszystko" Click="SelectAll_Click" Margin="0,0,10,0"/>
   <Button Content="Kopiuj SQL" Click="Copy_Click" Background="#126D6A" Foreground="White" FontWeight="SemiBold"/>
  </StackPanel>
  <Border x:Name="Snackbar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Padding="22,12" CornerRadius="8" Background="#192F3C" Visibility="Collapsed">
   <TextBlock x:Name="SnackText" Foreground="White" AutomationProperties.LiveSetting="Polite"/>
  </Border>
 </Grid>
</Window>
