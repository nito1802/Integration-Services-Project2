                      <ProjectItem
                        Name="ScriptMain.cs"
                        Encoding="UTF8"><![CDATA[using System;
using System.Data;
using System.Data.SqlClient;
using System.IO;
using System.Text;
using System.Globalization;
using System.Diagnostics;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_516108d2fa7a404baac1520193417cd1
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private void Run(Action work)
        {
            if (Convert.ToBoolean(Dts.Variables["User::JobActive"].Value) && Convert.ToBoolean(Dts.Variables["User::JobFailed"].Value))
            {
                Dts.TaskResult = (int)DTSExecResult.Success;
                return;
            }
            try { work(); Dts.TaskResult = (int)DTSExecResult.Success; }
            catch (Exception ex)
            {
                if (!Convert.ToBoolean(Dts.Variables["User::JobActive"].Value))
                {
                    Dts.Events.FireError(0, "CSV Archive", ex.ToString(), "", 0);
                    Dts.TaskResult = (int)DTSExecResult.Failure;
                    return;
                }
                Dts.Variables["User::JobFailed"].Value = true;
                Dts.Variables["User::JobError"].Value = ex.ToString();
                Dts.Events.FireWarning(0, "CSV Archive", "Job=" + Dts.Variables["User::ArchiveJobId"].Value + "; table=" + Convert.ToString(Dts.Variables["User::TableName"].Value, CultureInfo.InvariantCulture) + "; " + ex, "", 0);
                // Skip the remaining export; SetTableStatus persists this result afterwards.
                Dts.TaskResult = (int)DTSExecResult.Success;
            }
        }
                public void Main()
        {
            Run(delegate {
                var keys = (DataTable)Dts.Variables["User::BatchKeys"].Value;
                string table = Convert.ToString(Dts.Variables["User::TableName"].Value);
                var select = new List<string>();
                var match = new List<string>();
                foreach (DataColumn column in keys.Columns)
                {
                    string name = "[" + column.ColumnName.Replace("]", "]]") + "]";
                    select.Add("s." + name);
                    match.Add("s." + name + "=k." + name);
                }
                // A join prevents SELECT INTO from copying the source identity property.
                Dts.Variables["User::PrepareKeysSql"].Value =
                    "IF OBJECT_ID('tempdb..#ArchiveBatchKeys') IS NOT NULL DROP TABLE #ArchiveBatchKeys; " +
                    "SELECT TOP (0) " + string.Join(",", select.ToArray()) + " INTO #ArchiveBatchKeys FROM " + table + " s CROSS JOIN (SELECT 1 AS n) x;";
                Dts.Variables["User::DeleteSql"].Value =
                    "SET NOCOUNT ON; DELETE s FROM " + table + " s INNER JOIN #ArchiveBatchKeys k ON " + string.Join(" AND ", match.ToArray()) +
                    "; SELECT CONVERT(bigint,@@ROWCOUNT) AS DeletedRows;";
            });
        }

    }
}]]></ProjectItem>
