              <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[using System;
using System.Data;
using System.IO;
using System.Text;
using System.Globalization;
using System.Diagnostics;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_a2a2ef45c57c4ad786e0a868e2e256d2
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
                public void Main()
        {
            try { ExecuteJobStep(); }
            catch (Exception error)
            {
                Dts.Variables["User::JobFailed"].Value = true;
                Dts.Variables["User::JobError"].Value = error.ToString();
                // Continue only through the JobFailed guards to Save job result.
                // Do not fire OnError while this Script Task owns variable locks.
                Dts.TaskResult = (int)DTSExecResult.Success;
            }
        }

        private void ExecuteJobStep()
        {
            Dts.Variables["User::JobActive"].Value = true;
            Dts.Variables["User::JobFailed"].Value = false;
            Dts.Variables["User::JobError"].Value = "";
            Dts.Variables["User::OutputFile"].Value = "";
            Dts.Variables["User::BatchHasRows"].Value = true;
            Dts.Variables["User::BatchNumber"].Value = (long)0;
            Dts.Variables["User::ArchiwumPath"].Value = Convert.ToString(Dts.Variables["$Package::ArchiveRoot"].Value);
            Dts.TaskResult = (int)DTSExecResult.Success;
        }

    }
}
]]></ProjectItem>
