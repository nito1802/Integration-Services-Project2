              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[using System;
using System.Data;
using System.IO;
using System.Text;
using System.Globalization;
using System.Diagnostics;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_2e5e263af0ed4b72a5ab6d45fa65f96f
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
                public void Main()
        {
            const string step = "Log job result";
            var elapsed = Stopwatch.StartNew();

            Progress("START", step, ProgressContext());
            try { ExecuteLoggedStep(); }
            catch (Exception error)
            {
                Progress("ERROR", step, error.ToString());
                throw;
            }
            finally
            {
                bool failed = Dts.TaskResult == (int)DTSExecResult.Failure ;
                Progress(failed ? "FAILED" : "END", step, "elapsedMs=" + elapsed.ElapsedMilliseconds + "; " + ProgressContext() );
                Progress("JOB END", step, "status=" + (Convert.ToBoolean(Dts.Variables["User::JobFailed"].Value) ? "Error" : "Success") + "; " + ProgressContext()); Summary("JOB END", Convert.ToString(Dts.Variables["User::TableName"].Value), "status=" + (Convert.ToBoolean(Dts.Variables["User::JobFailed"].Value) ? "Error" : "Success") + "; database=" + Dts.Variables["User::DatabaseName"].Value + "; days=" + Dts.Variables["User::DayNumber"].Value + "; " + SummaryElapsed(Convert.ToInt64(Dts.Variables["User::JobStartedTicks"].Value)));
            }
        }

        private void ExecuteLoggedStep()
        {
            Dts.Variables["User::JobActive"].Value = false;
            bool failed = Convert.ToBoolean(Dts.Variables["User::JobFailed"].Value);
            if (failed) Dts.Variables["User::FailedJobs"].Value = Convert.ToInt32(Dts.Variables["User::FailedJobs"].Value) + 1;
            bool again = false;
            Dts.Events.FireInformation(0, "CSV Archive", "Table=" + Convert.ToString(Dts.Variables["User::TableName"].Value) + "; status=" + (failed ? "Error" : "Success") + "; path=" + Convert.ToString(Dts.Variables["User::OutputFile"].Value), "", 0, ref again);
            Dts.TaskResult = (int)DTSExecResult.Success;
        }

        private string ProgressContext()
        {
            if (Convert.ToInt32(Dts.Variables["User::JobNumber"].Value) == 0) return "";
            string context = "job=" + Dts.Variables["User::JobNumber"].Value +
                "; database=" + Convert.ToString(Dts.Variables["User::DatabaseName"].Value).Trim() +
                "; table=" + Convert.ToString(Dts.Variables["User::TableName"].Value).Trim();
            if (Convert.ToInt32(Dts.Variables["User::DayNumber"].Value) > 0)
                context += "; day=" + Convert.ToDateTime(Dts.Variables["User::CurrentDateFrom"].Value).ToString("yyyy-MM-dd") +
                    "; dayNumber=" + Dts.Variables["User::DayNumber"].Value +
                    "; memberIndex=" + Dts.Variables["User::MemberIndex"].Value +
                    "; rows=" + Dts.Variables["User::DayExportedRows"].Value + "/" + Dts.Variables["User::DayRows"].Value;
            return context;
        }

        private void Progress(string state, string step, string detail)
        {
            string file = Convert.ToString(Dts.Variables["User::RunLogFile"].Value);
            WriteProgress(file, state, step, detail);
        }

        private void WriteProgress(string file, string state, string step, string detail)
        {
            if (string.IsNullOrEmpty(file)) return;
            try
            {
                // Every compiled Script Task uses the same mutex for this run.
                // Readers never acquire it and can keep their own file handle open.
                using (var hash = System.Security.Cryptography.SHA256.Create())
                using (var mutex = new System.Threading.Mutex(false, "Local\\ArchiveLog_" +
                    BitConverter.ToString(hash.ComputeHash(Encoding.UTF8.GetBytes(file))).Replace("-", "")))
                {
                    bool acquired = false;
                    try
                    {
                        try { acquired = mutex.WaitOne(5000); }
                        catch (System.Threading.AbandonedMutexException) { acquired = true; }
                        if (!acquired) throw new IOException("Timed out waiting for the run log writer.");
                        using (var stream = new FileStream(file, FileMode.Append, FileAccess.Write,
                            FileShare.ReadWrite | FileShare.Delete))
                        using (var writer = new StreamWriter(stream, new UTF8Encoding(false)))
                        {
                            writer.WriteLine(DateTimeOffset.Now.ToString("o", CultureInfo.InvariantCulture) + " | " +
                                state + " | " + OneLine(step) + " | " + OneLine(detail));
                        }
                    }
                    finally { if (acquired) mutex.ReleaseMutex(); }
                }
            }
            catch (Exception error)
            {
                // An unavailable log must not turn a committed delete into a failed archive job.
                Dts.Events.FireWarning(0, "Archive progress log", error.Message, "", 0);
            }
        }

        private static string OneLine(string value)
        {
            return (value ?? "").Replace("\r", "\\r").Replace("\n", "\\n");
        }

        private void Summary(string state, string step, string detail)
        {
            WriteProgress(Convert.ToString(Dts.Variables["User::RunSummaryFile"].Value), state, step, detail);
        }

        private static string SummaryElapsed(long started)
        {
            double milliseconds = started <= 0 ? 0 :
                (Stopwatch.GetTimestamp() - started) * 1000.0 / Stopwatch.Frequency;
            return "elapsedMs=" + milliseconds.ToString("F1", CultureInfo.InvariantCulture) +
                "; duration=" + TimeSpan.FromMilliseconds(milliseconds).ToString("c", CultureInfo.InvariantCulture);
        }

    }
}]]></ProjectItem>
