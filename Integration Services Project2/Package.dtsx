                              <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[using System;
using System.Data;
using System.IO;
using System.Text;
using System.Globalization;
using System.Diagnostics;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_9e76d695057749d7aa5f1032a75889ca
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
                public void Main()
        {
            Dts.Variables["User::JobFailed"].Value = true;
            Dts.Variables["User::JobError"].Value = Convert.ToString(Dts.Variables["System::ErrorDescription"].Value);
            Dts.Variables["System::Propagate"].Value = false;
            Dts.TaskResult = (int)DTSExecResult.Success;
        }

    }
}
]]></ProjectItem>
