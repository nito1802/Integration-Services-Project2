                          <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[using System;
using System.Data;
using System.IO;
using System.Text;
using System.Globalization;
using System.Diagnostics;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_9867a770b2264ff1a21fe78fcbc98221
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
                public void Main()
        {
            try { ExecuteJobStep(); }
            catch (Exception error)
            {
                Dts.Variables["User::JobFailed"].Value = true;
                Dts.Variables["User::JobError"].Value = error.ToString();
                // Continue only through the JobFailed guards to Save job result.
                // Do not fire OnError while this Script Task owns variable locks.
                Dts.TaskResult = (int)DTSExecResult.Success;
            }
        }

        private void ExecuteJobStep()
        {
            int limit = Convert.ToInt32(Dts.Variables["$Package::MaxRecordsPerCsv"].Value);
            long offset = Convert.ToInt64(Dts.Variables["User::DayExportedRows"].Value);
            if(limit <= 0 || offset < 0) throw new ArgumentException("Invalid batch limit or offset.");
            var order = new List<string>();
            foreach(string key in Convert.ToString(Dts.Variables["User::KeyColumns"].Value).Split(','))
                order.Add("[" + key.Trim().Replace("]","]]") + "]");
            Dts.Variables["User::SQLStatement"].Value = "SELECT * FROM " + Convert.ToString(Dts.Variables["User::MemberSnapshot"].Value) + " ORDER BY " + string.Join(",",order.ToArray()) +
                " OFFSET " + offset.ToString(CultureInfo.InvariantCulture) + " ROWS FETCH NEXT " + limit.ToString(CultureInfo.InvariantCulture) + " ROWS ONLY;";
            Dts.TaskResult = (int)DTSExecResult.Success;
        }

    }
}
]]></ProjectItem>
