                  <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[using System;
using System.Data;
using System.Data.SqlClient;
using System.IO;
using System.Text;
using System.Globalization;
using System.Diagnostics;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_541f1ab9e84f44a6b78bcb5c07b814db
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
                public void Main()
        {
            Dts.Variables["User::SQLStatement"].Value = "SELECT TOP (1000) * FROM " + Convert.ToString(Dts.Variables["User::TableName"].Value) +
                " WHERE " + Convert.ToString(Dts.Variables["User::ColumnDate"].Value) + " < @Cutoff;";
            Dts.TaskResult = (int)DTSExecResult.Success;
        }

    }
}
]]></ProjectItem>
